{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Agent readiness evidence report",
  "description": "Reported evidence claims only; validation cannot verify their truth or grant authority.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "revision",
    "scope",
    "platforms",
    "gates"
  ],
  "properties": {
    "schema_version": {
      "const": "agent-readiness/v1"
    },
    "project": {
      "type": "string",
      "pattern": "\\S"
    },
    "revision": {
      "type": "string",
      "pattern": "\\S"
    },
    "scope": {
      "type": "string",
      "pattern": "\\S"
    },
    "platforms": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "\\S"
      }
    },
    "gates": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "discoverability",
        "structured_contract",
        "shared_substrate",
        "authority_and_safety",
        "concurrency_and_recovery",
        "portable_state",
        "reproducibility",
        "human_accessibility"
      ],
      "properties": {
        "discoverability": {
          "$ref": "#/$defs/gate"
        },
        "structured_contract": {
          "$ref": "#/$defs/gate"
        },
        "shared_substrate": {
          "$ref": "#/$defs/gate"
        },
        "authority_and_safety": {
          "$ref": "#/$defs/gate"
        },
        "concurrency_and_recovery": {
          "$ref": "#/$defs/gate"
        },
        "portable_state": {
          "$ref": "#/$defs/gate"
        },
        "reproducibility": {
          "$ref": "#/$defs/gate"
        },
        "human_accessibility": {
          "$ref": "#/$defs/gate"
        }
      }
    }
  },
  "$defs": {
    "gate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "status",
        "reason",
        "evidence"
      ],
      "properties": {
        "status": {
          "enum": [
            "pass",
            "fail",
            "unverified",
            "not_applicable"
          ]
        },
        "reason": {
          "type": "string",
          "pattern": "\\S"
        },
        "evidence": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "procedure",
              "artifact",
              "observation"
            ],
            "properties": {
              "procedure": {
                "type": "string",
                "pattern": "\\S"
              },
              "artifact": {
                "type": "string",
                "pattern": "\\S"
              },
              "observation": {
                "type": "string",
                "pattern": "\\S"
              }
            }
          }
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "status": {
                "const": "pass"
              }
            }
          },
          "then": {
            "properties": {
              "evidence": {
                "minItems": 1
              }
            }
          }
        }
      ]
    }
  }
}
